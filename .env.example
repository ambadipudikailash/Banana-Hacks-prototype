# Environment Configuration Template
# Copy this file to .env locally and fill in actual values.
# DO NOT COMMIT THE REAL .env FILE.

# Backend Configuration (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/visual_reverse_eng

# Frontend Configuration (Next.js). Mirror these in frontend/.env.local.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WORKSPACE_NAME=Kailash
